package com.mycompany.cargame2;


import com.badlogic.gdx.ApplicationAdapter;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.Input;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.GL20;
import com.badlogic.gdx.graphics.g2d.BitmapFont;
import com.badlogic.gdx.graphics.g2d.SpriteBatch;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;

public class MyGdxGame extends ApplicationAdapter {
    private ShapeRenderer shapeRenderer;
    private SpriteBatch batch;
    private BitmapFont font;
    private float characterX, characterY, characterSize, jumpVelocity, gravity, groundLevel;
    private float obstacleX, obstacleWidth, obstacleHeight, autoMoveSpeed;
    private boolean isJumping, gameOver, gameStarted;
    private int score;

    @Override
    public void create() {
        shapeRenderer = new ShapeRenderer();
        batch = new SpriteBatch();
        font = new BitmapFont();
        font.setColor(Color.WHITE);
        font.setScale(5); // লেখার সাইজ বড়

        characterX = 50;
        groundLevel = 50;
        characterY = groundLevel;
        characterSize = 90;
        jumpVelocity = 0;
        gravity = -15;
        isJumping = false;

        obstacleWidth = 40;
        obstacleHeight = 70;
        obstacleX = Gdx.graphics.getWidth();

        gameOver = false;
        gameStarted = false;
        autoMoveSpeed = 150;

        score = 0;
    }

    @Override
    public void render() {
        Gdx.gl.glClearColor(0, 0, 0, 1);
        Gdx.gl.glClear(GL20.GL_COLOR_BUFFER_BIT);

        shapeRenderer.begin(ShapeRenderer.ShapeType.Filled);

        if (!gameStarted) {
            batch.begin();
            font.draw(batch, "Start", Gdx.graphics.getWidth() / 2f - 100, Gdx.graphics.getHeight() / 2f + 20);
            batch.end();

            if (Gdx.input.justTouched()) {
                gameStarted = true;
            }
        } else if (!gameOver) {
            updateGame();
        } else {
            drawGameOver();
        }

        shapeRenderer.end();
    }

    private void updateGame() {
        handleInput();
        updateCharacter();
        updateObstacle();
        checkCollision();

        // গাড়ি আঁকা
        drawCar();

        // বাধা আঁকা
        shapeRenderer.setColor(Color.GREEN);
        shapeRenderer.rect(obstacleX, groundLevel, obstacleWidth, obstacleHeight);

        // স্কোর দেখানো
        batch.begin();
        font.draw(batch, "Score: " + score, 50, Gdx.graphics.getHeight() - 50);
        batch.end();
    }

    private void drawCar() {
        // গাড়ির বডি
        shapeRenderer.setColor(Color.BLUE);
        shapeRenderer.rect(characterX, characterY, characterSize, characterSize / 2);

        // জানালা
        shapeRenderer.setColor(Color.CYAN);
        shapeRenderer.rect(characterX + 10, characterY + characterSize / 4, characterSize / 2, characterSize / 4);

        // হেডলাইট
        shapeRenderer.setColor(Color.YELLOW);
        shapeRenderer.circle(characterX + characterSize, characterY + characterSize / 4, 10);

        // চাকা
        shapeRenderer.setColor(Color.BLACK);
        shapeRenderer.circle(characterX + 10, characterY - 10, 15);
        shapeRenderer.circle(characterX + characterSize - 10, characterY - 10, 15);
    }

    private void drawGameOver() {
        drawCar();

        shapeRenderer.setColor(Color.GREEN);
        shapeRenderer.rect(obstacleX, groundLevel, obstacleWidth, obstacleHeight);

        batch.begin();
        font.draw(batch, "Game Over!", Gdx.graphics.getWidth() / 2f - 200, Gdx.graphics.getHeight() / 2f + 100);
        font.draw(batch, "Score: " + score, Gdx.graphics.getWidth() / 2f - 150, Gdx.graphics.getHeight() / 2f + 20);
        font.draw(batch, "Start", Gdx.graphics.getWidth() / 2f - 100, Gdx.graphics.getHeight() / 2f - 50);
        batch.end();

        if (Gdx.input.justTouched()) {
            resetGame();
        }
    }

    private void handleInput() {
        if ((Gdx.input.isKeyJustPressed(Input.Keys.SPACE) ||
			Gdx.input.isKeyJustPressed(Input.Keys.UP) ||
			Gdx.input.justTouched()) && !isJumping) {
            jumpVelocity = 700;
            isJumping = true;
        }
    }

    private void updateCharacter() {
        if (isJumping) {
            characterY += jumpVelocity * Gdx.graphics.getDeltaTime();
            jumpVelocity += gravity;

            if (characterY <= groundLevel) {
                characterY = groundLevel;
                isJumping = false;
                jumpVelocity = 0;
            }
        }
    }

    private void updateObstacle() {
        obstacleX -= autoMoveSpeed * Gdx.graphics.getDeltaTime();

        if (obstacleX + obstacleWidth < 0) {
            obstacleX = Gdx.graphics.getWidth();
            score += 1;
            autoMoveSpeed += 10;
        }
    }

    private void checkCollision() {
        if (characterX + characterSize > obstacleX &&
			characterX < obstacleX + obstacleWidth &&
			characterY < groundLevel + obstacleHeight) {
            gameOver = true;
        }
    }

    private void resetGame() {
        characterX = 50;
        characterY = groundLevel;
        jumpVelocity = 0;
        isJumping = false;
        obstacleX = Gdx.graphics.getWidth();
        gameOver = false;
        gameStarted = true;
        score = 0;
        autoMoveSpeed = 150;
    }

    @Override
    public void dispose() {
        shapeRenderer.dispose();
        batch.dispose();
        font.dispose();
    }
}